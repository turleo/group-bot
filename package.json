{
  "name": "group-bot",
  "module": "src/index.ts",
  "type": "module",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/bun": "^1.1.6",
    "eslint": "^9.39.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "simple-git-hooks": "^2.13.1",
    "typescript-eslint": "^8.47.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "scripts": {
    "run": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit --project .",
    "lint": "eslint .",
    "format": "eslint . --fix"
  },
  "dependencies": {
    "@mtcute/bun": "^0.16.7",
    "@mtcute/dispatcher": "^0.16.7"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint"
  }
}
