{
  "name": "group-bot",
  "module": "src/index.ts",
  "type": "module",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.3.12",
    "eslint": "^9.39.4",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "simple-git-hooks": "^2.13.1",
    "typescript-eslint": "^8.58.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "scripts": {
    "run": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit --project .",
    "lint": "eslint .",
    "format": "eslint . --fix"
  },
  "dependencies": {
    "@mtcute/bun": "^0.29.6",
    "@mtcute/dispatcher": "^0.29.6"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint"
  }
}
